# Patent Intel configuration
# Copy to `.env` and fill in. `.env` is git-ignored: never commit real values.

# --- Storage -------------------------------------------------------------------------------------
# MongoDB connection string. Leave empty to write JSON files into DATA_DIR instead.
#   e.g. mongodb+srv://<user>:<password>@<cluster-host>/?retryWrites=true&w=majority
MONGO_URI=
MONGO_DB=patent_intel
# Cache and JSON output directory
DATA_DIR=Patents_Data

# --- REST API ------------------------------------------------------------------------------------
# Comma-separated keys, each at least 32 characters.
#   python -c "import secrets;print(secrets.token_urlsafe(32))"
API_KEYS=
# Comma-separated frontend origins allowed by CORS (https://..., or http://localhost for development)
CORS_ORIGINS=
# Interactive API docs at /docs (keep false in production)
ENABLE_DOCS=false
MAX_CONCURRENT_JOBS=1
MAX_QUEUED_JOBS=10
# Hard time limit for one crawl job, in seconds
JOB_TIMEOUT_S=7200

# --- Crawl budgets (API requests can lower, never raise these) -----------------------------------
MAX_PAGES=600
PROBE_PAGES=150
