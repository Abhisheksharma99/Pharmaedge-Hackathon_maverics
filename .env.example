# Patent Intel configuration
# Copy to `.env` and fill in. `.env` is git-ignored: never commit real values.

# --- Storage -------------------------------------------------------------------------------------
# MongoDB connection string. Leave empty to write JSON files into DATA_DIR instead.
#   e.g. mongodb+srv://<user>:<password>@<cluster-host>/?retryWrites=true&w=majority
MONGO_URI=
MONGO_DB=patent_intel
# CA that verifies MongoDB's certificate: empty = certifi public bundle (Atlas); "system" = server OS trust store;
# or a path to a CA file (private/corporate CA). Outbound HTTPS honours the standard SSL_CERT_FILE / SSL_CERT_DIR.
MONGO_TLS_CA_FILE=
# Cache and JSON output directory
DATA_DIR=Patents_Data

# --- REST API ------------------------------------------------------------------------------------
# Comma-separated keys, each at least 32 characters.
#   python -c "import secrets;print(secrets.token_urlsafe(32))"
API_KEYS=
# Comma-separated frontend origins allowed by CORS (https://..., or http://localhost for development)
CORS_ORIGINS=
# Interactive API docs at /docs (keep false in production)
ENABLE_DOCS=false
MAX_CONCURRENT_JOBS=1
MAX_QUEUED_JOBS=10
# Hard time limit for one crawl job, in seconds
JOB_TIMEOUT_S=7200

# --- Regulatory timeline (SEC EDGAR + openFDA) ---------------------------------------------------
# Required for SEC EDGAR (SEC fair-access policy): "Company Name contact@email.com"
SEC_USER_AGENT=
# Event-date window: REG_START .. today + REG_END_MONTHS (end moves forward automatically).
# Set REG_END=YYYY-MM-DD only to pin a fixed end date.
REG_START=2013-01-01
REG_END_MONTHS=19
REG_MAX_FILINGS=300

# --- Stock impact prices (patent_intel.market) ------------------------------------------------------
# Prices come from Yahoo's keyless endpoint: LOCAL TESTING ONLY.
MARKET_PRICE_TTL_S=21600

# --- Crawl budgets (API requests can lower, never raise these) -----------------------------------
MAX_PAGES=600
PROBE_PAGES=150

# --- Presentation intelligence (patent_intel.presentations) ------------------------------------------
# Vision is OFF unless OPENAI_API_KEY is set. When set, selected slide images are sent to OpenAI.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-6-luna
PRESENTATION_LATEST_N=6
PRESENTATION_MAX_CONCURRENT=1
PRESENTATION_MAX_QUEUE_SIZE=10
PRESENTATION_MAX_PDF_MB=60
PRESENTATION_MAX_PAGES=200
PRESENTATION_MAX_PAGE_PIXELS=16000000
PRESENTATION_RENDER_DPI=110
PRESENTATION_MAX_IMAGES_PER_PAGE=20
PRESENTATION_MEMORY_LIMIT_MB=1024
PRESENTATION_JOB_TIMEOUT_S=1800
PRESENTATION_PAGE_TIMEOUT_S=60
PRESENTATION_VISION_MAX_PAGES=40
PRESENTATION_VISION_CONCURRENCY=8
PRESENTATION_VISION_TIMEOUT_S=90
# Output budget per slide incl. the model's reasoning tokens (luna models max: 128000). Billed per generated
# token, so the ceiling costs nothing extra on normal slides. A cut-off answer is retried once with the RETRY budget
# (set it equal to the normal budget to disable that retry). Transient errors: up to MAX_ATTEMPTS with backoff.
PRESENTATION_VISION_MAX_OUTPUT_TOKENS=12000
PRESENTATION_VISION_RETRY_MAX_OUTPUT_TOKENS=24000
PRESENTATION_VISION_MAX_ATTEMPTS=5
PRESENTATION_VISION_IMAGE_MAX_SIDE=1600
