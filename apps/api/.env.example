# Copy to apps/api/.env (git-ignored). Values without defaults are required.
NODE_ENV=development
PORT=3000

# Self-hosted MongoDB (same database the crawlers write to); see infra/mongo/README.md.
# The password is MONGO_APP_PASSWORD in infra/mongo/secrets/mongo.env.
MONGODB_URI=mongodb://app:<MONGO_APP_PASSWORD>@localhost:27017/?directConnection=true&authSource=admin&tls=true&tlsCAFile=<repo>/infra/mongo/secrets/ca.pem
MONGODB_DB=asset_journey

# Valkey (docker compose maps it to host port 6380)
VALKEY_URL=redis://localhost:6380
VALKEY_PREFIX=aj:

# Auth. JWT_SECRET: at least 32 chars, e.g.  openssl rand -base64 48
JWT_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
# Defaults to true when NODE_ENV=production (requires HTTPS)
# COOKIE_SECURE=false

# First admin, created on first boot if no admin exists. Password: at least 12 chars.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator

# Internal crawl service (crawler/service). Same key in crawler/.env
CRAWLER_API_URL=http://localhost:8100
CRAWLER_SERVICE_KEY=

# Asset AI (OpenAI). Without a key the app runs and chat answers "Asset AI is not configured".
OPENAI_API_KEY=
# LLM_CHAT_MODEL=gpt-6-luna
# gpt-6-luna takes function tools on Chat Completions only with reasoning off
# LLM_CHAT_REASONING_EFFORT=none
# LLM_FOLLOWUP_MODEL=gpt-6-luna
# LLM_FOLLOWUP_REASONING_EFFORT=none
# Must match the crawler's search index (crawler/.env)
# LLM_EMBEDDING_MODEL=text-embedding-3-small
# Retrieval stages after hybrid search in search_evidence (comma separated: rerank, judge, hyde; empty = none)
# LLM_RAG_MODEL=gpt-6-luna
# RAG_STAGES=rerank   (default; measured MRR 0.793 -> 0.916; judge and hyde measured and left off, see DECISIONS.md)
# EMBEDDING_DIMENSIONS=1536
