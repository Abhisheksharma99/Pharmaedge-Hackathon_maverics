# Self-hosted MongoDB, see infra/mongo/README.md (never commit the real one; put it in .env).
# The password is MONGO_APP_PASSWORD in infra/mongo/secrets/mongo.env.
MONGODB_URI=mongodb://app:<MONGO_APP_PASSWORD>@localhost:27017/?directConnection=true&authSource=admin&tls=true&tlsCAFile=<repo>/infra/mongo/secrets/ca.pem
MONGODB_DB=asset_journey

# Standalone: no decode worker exists here, so decode Google News links inline
GOOGLE_DECODE_MODE=inline

# Optional
# OPENFDA_API_KEY=
# RSS_MAX_ARTICLE_AGE_HOURS=0        # 0 = keep everything (default here)
# RESIDENTIAL_PROXY=                 # or PROXY_USERNAME/PROXY_PASSWORD/PROXY_HOST/PROXY_PORT
# PROXY_ENABLED=false
# BROKER_URL=                        # remote browser broker; unset = local Chromium
# SEC_USER_AGENT=                    # "Company contact@email" (SEC fair-access policy); required by the
#                                    # sec_regulatory step (PDUFA dates, CRLs from filings) - skipped without it

# AI ingestion (crawler/ai/llm.py). Defaults shown; every call is cached by content hash in `llm_cache`.
# OPENAI_API_KEY=
# LLM_TRIAGE_MODEL=gpt-6-luna          # triage + duplicate grouping ($0.10 in / $0.50 out per 1M tokens)
# LLM_REASONING_MODEL=gpt-6-luna       # event extraction, resolve, competitors, patent assignees
# LLM_TRIAGE_EFFORT=low                # reasoning effort: none|low|medium|high|xhigh|max ("" for gpt-4.x models)
# LLM_EXTRACT_EFFORT=medium
# LLM_SERVICE_TIER=                    # "flex" = half price, slower (background refreshes); falls back to standard
# LLM_MAX_OUTPUT_TOKENS=16000          # ceiling per call; a cut-off answer is retried next run, never parsed
# LLM_EMBEDDING_MODEL=text-embedding-3-small   # must match the API's (query embeddings)
# EMBEDDING_DIMENSIONS=1536
